# What NOT to upload to Cloud Run. Its presence means .gitignore is no longer consulted,
# so anything secret has to be named here too.

.git/
.github/
.gitignore

.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# The frontend deploys to Cloudflare Pages, not here.
web/

# Not needed to serve a request.
tests/
scripts/
migrations/
*.md

.env
